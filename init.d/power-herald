#!/sbin/openrc-run

description="Power Herald combined daemon"
command="/opt/power-herald/venv/bin/python"
command_args="-m src.server"
pidfile="/var/run/power-herald.pid"
logfile="/var/log/power-herald/server.log"
logfile_error="/var/log/power-herald/server.err"
user="powerherald"
group="powerherald"
directory="/opt/power-herald"

depend() {
    need net
}

start_pre() {
    if [ ! -d "$directory" ]; then
        eerror "Directory $directory does not exist"
        return 1
    fi
    if [ ! -d "$(dirname "$logfile")" ]; then
        eerror "Log directory $(dirname "$logfile") does not exist"
        return 1
    fi
}

start() {
    ebegin "Starting Power Herald"
    cd "$directory"
    start-stop-daemon --start --pidfile "$pidfile" \
        --user "$user" --group "$group" \
        --make-pidfile --background \
        --stdout "$logfile" \
        --stderr "$logfile_error" \
        --exec "$command" -- $command_args
    eend $?
}

stop() {
    ebegin "Stopping Power Herald"
    start-stop-daemon --stop --pidfile "$pidfile" --retry TERM/30/KILL/5
    eend $?
}