#!/sbin/openrc-run

description="Power Herald combined daemon"
command="/opt/power_herald/venv/bin/python"
command_args="-m src.server"
pidfile="/var/run/power_herald.pid"
user="power_herald"
group="power_herald"
directory="/opt/power_herald"

depend() {
    need net
}

start_pre() {
    if [ ! -d "$directory" ]; then
        eerror "Directory $directory does not exist"
        return 1
    fi
}

start() {
    ebegin "Starting Power Herald"
    cd "$directory"
    start-stop-daemon --start --pidfile "$pidfile" \
        --user "$user" --group "$group" \
        --make-pidfile --background \
        --exec "$command" -- $command_args
    eend $?
}

stop() {
    ebegin "Stopping Power Herald"
    start-stop-daemon --stop --pidfile "$pidfile" --retry TERM/30/KILL/5
    eend $?
}